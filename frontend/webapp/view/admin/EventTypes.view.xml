<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  controllerName="ui.calendar.controller.admin.EventTypes">
  <Page
    title="{i18n>adminEventTypesTitle}"
    showNavButton="true"
    navButtonPress=".onNavHome"
    class="callcal-page-content">
    <headerContent>
      <Button
        text="{i18n>navAdminBookings}"
        press=".onNavToBookings" />
    </headerContent>
    <content>
      <Table
        id="eventTypesTable"
        items="{view>/eventTypes}"
        busy="{view>/busy}"
        noDataText="{i18n>adminEventTypesEmpty}"
        sticky="ColumnHeaders,HeaderToolbar"
        growing="true">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{i18n>adminEventTypesTitle}" level="H2" />
            <ToolbarSpacer />
            <Button
              text="{i18n>adminEventTypesCreateButton}"
              icon="sap-icon://add"
              type="Emphasized"
              press=".onCreate" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column>
            <Text text="{i18n>adminEventTypesNameLabel}" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="{i18n>adminEventTypesDescriptionLabel}" />
          </Column>
          <Column hAlign="End" width="9rem">
            <Text text="{i18n>adminEventTypesDurationLabel}" />
          </Column>
          <Column hAlign="End" width="11rem" />
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{view>name}" />
              <Text text="{view>description}" wrapping="true" />
              <Text text="{view>durationMinutes}" />
              <HBox justifyContent="End">
                <Button
                  icon="sap-icon://edit"
                  tooltip="{i18n>adminEventTypesEditButton}"
                  press=".onEdit" />
                <Button
                  icon="sap-icon://delete"
                  tooltip="{i18n>adminEventTypesDeleteButton}"
                  press=".onDelete" />
              </HBox>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
